FLORAL_IMAGE=namelsscinder/floral-sync-server:latest

# Optional on first boot. If left empty, the container will generate them,
# persist them into sync-server.toml, and print the sync token in startup logs.
FLORAL_SYNC_TOKEN=replace-with-a-long-random-sync-token
FLORAL_ADMIN_SESSION_SECRET=replace-with-a-long-random-admin-session-secret

# Optional. Leave empty on first boot and complete the admin bootstrap flow in the web UI.
FLORAL_ADMIN_PASSWORD_HASH=

# Persist config, database, exports, and logs on the host. Relative paths are resolved next to docker/compose.yml.
FLORAL_HOST_CONFIG_DIR=./floral/config
FLORAL_HOST_DATA_DIR=./floral/data
FLORAL_HOST_EXPORT_DIR=./floral/exports
FLORAL_HOST_LOG_DIR=./floral/logs

# Set to 1 only when you want the container to rewrite sync-server.toml from env vars.
FLORAL_FORCE_WRITE_CONFIG=0

FLORAL_SYNC_PUBLISHED_PORT=8787
FLORAL_ADMIN_PUBLISHED_PORT=8788
FLORAL_LOG_LEVEL=info